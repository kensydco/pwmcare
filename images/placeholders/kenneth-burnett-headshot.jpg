<svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGradient3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1E3D5A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2E5B8A;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="400" height="500" fill="url(#bgGradient3)"/>

  <!-- Professional silhouette -->
  <circle cx="200" cy="180" r="70" fill="rgba(255,255,255,0.3)"/>
  <ellipse cx="200" cy="320" rx="120" ry="100" fill="rgba(255,255,255,0.3)"/>

  <!-- Text overlay -->
  <text x="200" y="420" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="white" text-anchor="middle">
    Kenneth Burnett
  </text>
  <text x="200" y="450" font-family="Arial, sans-serif" font-size="18" fill="rgba(255,255,255,0.9)" text-anchor="middle">
    MBA
  </text>
  <text x="200" y="475" font-family="Arial, sans-serif" font-size="14" fill="rgba(255,255,255,0.8)" text-anchor="middle">
    Chief Operating Officer
  </text>
</svg>
