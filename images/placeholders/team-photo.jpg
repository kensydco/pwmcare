<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="teamBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F8F9FA;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E9ECEF;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill="url(#teamBg)"/>

  <!-- Three silhouettes representing the team -->
  <!-- Left figure -->
  <circle cx="200" cy="200" r="60" fill="#2E5B8A" opacity="0.7"/>
  <ellipse cx="200" cy="340" rx="100" ry="90" fill="#2E5B8A" opacity="0.7"/>

  <!-- Center figure -->
  <circle cx="400" cy="180" r="70" fill="#4A9B9B" opacity="0.7"/>
  <ellipse cx="400" cy="330" rx="110" ry="100" fill="#4A9B9B" opacity="0.7"/>

  <!-- Right figure -->
  <circle cx="600" cy="200" r="60" fill="#6B8E5A" opacity="0.7"/>
  <ellipse cx="600" cy="340" rx="100" ry="90" fill="#6B8E5A" opacity="0.7"/>

  <!-- Medical cross icon in background -->
  <g opacity="0.1">
    <rect x="380" y="50" width="40" height="120" fill="#2E5B8A"/>
    <rect x="360" y="70" width="80" height="80" fill="#2E5B8A"/>
  </g>

  <!-- Text -->
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#2E5B8A" text-anchor="middle">
    Precision Wound Management Team
  </text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="20" fill="#6C757D" text-anchor="middle">
    Expert, Compassionate Wound Care
  </text>
</svg>
